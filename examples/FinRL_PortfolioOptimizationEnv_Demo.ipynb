    "portfolio_raw_df = portfolio_raw_df.sort_values([\"date\", \"tic\"]).reset_index(drop=True)\n",
    "\n",
    "# 检查合并后的数据\n",
    "print(portfolio_raw_df.head())\n",
    "print(portfolio_raw_df.tail())"
